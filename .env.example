# ─────────────────────────────────────────────────────────
# Supabase
#
# LOCAL DEV  → run `supabase start`, copy keys from its output
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from supabase start output>
#   SUPABASE_SERVICE_ROLE_KEY=<service_role key from supabase start output>
#
# STAGING    → Supabase dashboard → Project Settings → API (dev project)
# PROD       → Supabase dashboard → Project Settings → API (prod project)
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key   # NEVER use NEXT_PUBLIC_ prefix — server-side only

# NEXT_PUBLIC_SUPABASE_ANON_KEY is deliberately not listed. Every query in this
# app goes through the service-role client in src/lib/supabase/server.ts; there
# is no browser Supabase client, so the anon key is read nowhere in src/.
# Publishing a key with no purpose is surface area for nothing in return.
# (DEPLOYMENT.md still shows it for the local stack's own output; it is not
# needed by the app.)

# ─────────────────────────────────────────────────────────
# Razorpay
# Use rzp_test_* keys for local/staging. Never commit live keys.
# Get from: https://dashboard.razorpay.com → API Keys
# RAZORPAY_KEY_ID is server-side only — the client receives it only from the create-order response.
# ─────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-here           # NEVER use NEXT_PUBLIC_ prefix — server-side only
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret-here         # NEVER use NEXT_PUBLIC_ prefix — server-side only

# ─────────────────────────────────────────────────────────
# Property contact (server-side — used in API routes and server components)
# ─────────────────────────────────────────────────────────
# WhatsApp number in international format, no + or spaces (e.g. 918050484123).
# Leave blank if there is no WhatsApp line: the app then hides every WhatsApp
# button. Never put a sample number here: a working link to a stranger's number
# is worse than no button.
PROPERTY_WHATSAPP=
PROPERTY_PHONE=
PROPERTY_EMAIL=reservations@habbaa.com

# ─────────────────────────────────────────────────────────
# App URL (canonical URLs, sitemap, OG images — server-side)
# Local: http://localhost:3000 | Prod: https://villa19.in
# ─────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────
# Where email images are loaded from. Optional: leave unset.
# Deliberately not APP_URL: webmail fetches images through its own proxy, so the
# host must both be public AND actually be serving this app. APP_URL is neither
# on localhost, nor while it points at a domain that is still parked.
# On Vercel this resolves to VERCEL_URL on its own, which always serves the
# running build. Set this only to pin images to a CDN or a custom domain.
# ─────────────────────────────────────────────────────────
EMAIL_ASSET_BASE_URL=

# ─────────────────────────────────────────────────────────
# Email notifications (Resend)
# Every send goes to the Resend API, in local development too: there is no
# Inbucket capture on this path, so a real key sends real mail.
# The sender's domain must be verified in the Resend account.
# ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
# Sender for all guest mail. Falls back to the registered entity address.
RESEND_FROM_EMAIL=Villa 19 by Habbaa <reservations@habbaa.com>
# Where the new-booking notice lands.
ADMIN_EMAIL=reservations@habbaa.com

# ─────────────────────────────────────────────────────────
# Content refresh (server-side)
# Shared with Ooruda Villa. It calls POST /api/revalidate with
# "Authorization: Bearer <this value>" after publishing a journal post or
# editing content, so the change appears without a redeploy.
# Generate with: openssl rand -hex 32. Leave blank to disable the endpoint.
# ─────────────────────────────────────────────────────────
CONTENT_REVALIDATE_SECRET=

# ─────────────────────────────────────────────────────────
# Search engine verification (server-side, optional)
# The content value of the verification meta tag from Google Search Console
# and Bing Webmaster Tools. Leave blank until each site is verified.
# ─────────────────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
